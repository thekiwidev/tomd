{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tomd",
  "version": "0.2.0",
  "identifier": "dev.thekiwidev.tomd",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist-ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "tomd",
        "width": 620,
        "height": 700,
        "minWidth": 480,
        "minHeight": 460,
        "visible": false
      },
      {
        "label": "dropzone",
        "title": "tomd drop zone",
        "width": 300,
        "height": 260,
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "shadow": true
      },
      {
        "label": "toast",
        "title": "tomd status",
        "width": 260,
        "height": 48,
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
