{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "All tomd windows",
  "windows": ["main", "dropzone", "toast"],
  "permissions": [
    "core:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir",
    "drag:default"
  ]
}
